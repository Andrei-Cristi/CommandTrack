<Window x:Class="CommandTrack.HQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommandTrack HQ"
        Width="1400"
        Height="760"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#10141C">

    <Window.Resources>

        <!-- General text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#E8EDF5"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
        </Style>

        <!-- Dashboard cards -->
        <Style x:Key="DashboardCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#1A2130"/>
            <Setter Property="BorderBrush"
                    Value="#2A3447"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="18"/>
            <Setter Property="Margin"
                    Value="0,0,14,0"/>
        </Style>

        <!-- Detail labels -->
        <Style x:Key="DetailLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#7F8A9B"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,14,0,4"/>
        </Style>

        <!-- Detail values -->
        <Style x:Key="DetailValueStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#E8EDF5"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#2878D4"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="18,9"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#378AE6"/>
                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="#1F65B5"/>
                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Background"
                            Value="#344052"/>
                    <Setter Property="Foreground"
                            Value="#8490A2"/>
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"
                    Value="#151B26"/>
            <Setter Property="Foreground"
                    Value="#E8EDF5"/>
            <Setter Property="BorderBrush"
                    Value="#2A3447"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="RowBackground"
                    Value="#151B26"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#192130"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#283246"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="#283246"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="CanUserAddRows"
                    Value="False"/>
            <Setter Property="CanUserDeleteRows"
                    Value="False"/>
            <Setter Property="CanUserResizeRows"
                    Value="False"/>
            <Setter Property="AutoGenerateColumns"
                    Value="False"/>
            <Setter Property="IsReadOnly"
                    Value="True"/>
            <Setter Property="SelectionMode"
                    Value="Single"/>
            <Setter Property="SelectionUnit"
                    Value="FullRow"/>
            <Setter Property="RowHeight"
                    Value="48"/>
        </Style>

        <!-- DataGrid headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#20293A"/>
            <Setter Property="Foreground"
                    Value="#C9D3E3"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="12,10"/>
            <Setter Property="BorderBrush"
                    Value="#2A3447"/>
            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>
        </Style>

        <!-- DataGrid rows -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground"
                    Value="#E8EDF5"/>
            <Setter Property="Background"
                    Value="#151B26"/>

            <Style.Triggers>
                <Trigger Property="AlternationIndex"
                         Value="1">
                    <Setter Property="Background"
                            Value="#192130"/>
                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#202D42"/>
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#263B5C"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid cells: prevents white selected row -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"
                    Value="12,8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="#E8EDF5"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#263B5C"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                    <Setter Property="BorderBrush"
                            Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBox items -->
        <Style x:Key="DarkComboBoxItemStyle"
               TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="#E8EDF5"/>
            <Setter Property="Background"
                    Value="#151B26"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">

                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#263B5C"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#2878D4"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox -->
        <Style x:Key="DarkComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Foreground"
                    Value="#E8EDF5"/>
            <Setter Property="Background"
                    Value="#151B26"/>
            <Setter Property="BorderBrush"
                    Value="#36445B"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItemStyle}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#151B26"
                                                BorderBrush="#36445B"
                                                BorderThickness="1"
                                                CornerRadius="4">

                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,0,12,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem,
                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="#E8EDF5"/>

                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      VerticalAlignment="Center"
                                                      Fill="#AAB5C7"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="ComboBorder"
                                                        Property="BorderBrush"
                                                        Value="#4F78AA"/>
                                                <Setter TargetName="ComboBorder"
                                                        Property="Background"
                                                        Value="#1C2635"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ToggleButton}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Width="{Binding ActualWidth,
                                       RelativeSource={RelativeSource TemplatedParent}}">

                                <Border Margin="0,3,0,0"
                                        Background="#151B26"
                                        BorderBrush="#36445B"
                                        BorderThickness="1"
                                        CornerRadius="4">

                                    <ScrollViewer MaxHeight="220"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ToggleButton"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CommandTrack HQ"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Operational unit monitoring dashboard"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#8F9BAD"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <StackPanel Margin="0,0,16,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Last refresh"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#7F8A9B"/>

                    <TextBlock x:Name="LastRefreshTextBlock"
                               Text="Not loaded"
                               HorizontalAlignment="Right"
                               FontSize="13"/>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Content="Refresh"/>
            </StackPanel>
        </Grid>

        <!-- Summary cards -->
        <Grid Grid.Row="1"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>
                    <TextBlock Text="TOTAL UNITS"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8F9BAD"/>

                    <TextBlock x:Name="TotalUnitsTextBlock"
                               Text="0"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>
                    <TextBlock Text="ONLINE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8F9BAD"/>

                    <TextBlock x:Name="OnlineUnitsTextBlock"
                               Text="0"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#4BD58A"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}"
                    Margin="0">

                <StackPanel>
                    <TextBlock Text="OFFLINE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8F9BAD"/>

                    <TextBlock x:Name="OfflineUnitsTextBlock"
                               Text="0"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#F06C75"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Unit table -->
            <Border Grid.Column="0"
                    Background="#151B26"
                    BorderBrush="#2A3447"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="1">

                <DataGrid x:Name="UnitsDataGrid"
                          AlternationCount="2">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Call sign"
                                            Binding="{Binding CallSign}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding Type}"
                                            Width="150"/>

                        <DataGridTemplateColumn Header="Status"
                                                Width="110">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBadge"
                                            HorizontalAlignment="Left"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Background="#485365">

                                        <TextBlock Text="{Binding Status}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Online">
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#17663F"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Offline">
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#71323A"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Busy">
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#8A5A16"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Maintenance">
                                            <Setter TargetName="StatusBadge"
                                                    Property="Background"
                                                    Value="#594183"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Battery"
                                            Binding="{Binding BatteryDisplay}"
                                            Width="95"/>

                        <DataGridTextColumn Header="Speed"
                                            Binding="{Binding SpeedDisplay}"
                                            Width="105"/>

                        <DataGridTextColumn Header="Position"
                                            Binding="{Binding PositionDisplay}"
                                            Width="210"/>

                        <DataGridTextColumn Header="Last seen"
                                            Binding="{Binding LastSeenDisplay}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Details panel -->
            <Border Grid.Column="2"
                    Background="#1A2130"
                    BorderBrush="#2A3447"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    DataContext="{Binding SelectedItem,
                                          ElementName=UnitsDataGrid}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="UNIT DETAILS"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#8F9BAD"/>

                        <TextBlock Text="{Binding CallSign,
                                                 FallbackValue=Select a unit}"
                                   Margin="0,8,0,2"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding Type,
                                                 FallbackValue=Choose a unit from the table}"
                                   FontSize="13"
                                   Foreground="#8F9BAD"/>

                        <Border x:Name="SelectedStatusBadge"
                                Margin="0,18,0,4"
                                HorizontalAlignment="Left"
                                CornerRadius="14"
                                Padding="12,5">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="#485365"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Online">
                                            <Setter Property="Background"
                                                    Value="#17663F"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Offline">
                                            <Setter Property="Background"
                                                    Value="#71323A"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Busy">
                                            <Setter Property="Background"
                                                    Value="#8A5A16"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="Maintenance">
                                            <Setter Property="Background"
                                                    Value="#594183"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding Status,
                                                      FallbackValue=No selection}"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Separator Margin="0,18,0,4"
                                   Background="#2A3447"/>

                        <TextBlock Text="UNIT ID"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <TextBlock Text="{Binding IdDisplay,
                                                 FallbackValue=—}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="BATTERY"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <TextBlock Text="{Binding BatteryDisplay,
                                                 FallbackValue=—}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="SPEED"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <TextBlock Text="{Binding SpeedDisplay,
                                                 FallbackValue=—}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="POSITION"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <TextBlock Text="{Binding PositionDisplay,
                                                 FallbackValue=—}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="CREATED"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <TextBlock Text="{Binding CreatedAtDisplay,
                                                 FallbackValue=—}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="LAST SEEN"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <TextBlock Text="{Binding LastSeenDisplay,
                                                 FallbackValue=—}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <TextBlock Text="LATEST TELEMETRY"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <TextBlock Text="{Binding TelemetryRecordedAtDisplay,
                                                 FallbackValue=—}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <Separator Margin="0,20,0,4"
                                   Background="#2A3447"/>

                        <TextBlock Text="MANUAL STATUS"
                                   Style="{StaticResource DetailLabelStyle}"/>

                        <ComboBox x:Name="StatusComboBox"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  Height="38"
                                  Margin="0,4,0,10"
                                  IsEnabled="False"/>

                        <Button x:Name="UpdateStatusButton"
                                Content="Update Status"
                                Height="38"
                                IsEnabled="False"/>

                        <TextBlock x:Name="StatusUpdateMessageTextBlock"
                                   Margin="0,10,0,0"
                                   Foreground="#8F9BAD"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready"
                       Foreground="#8F9BAD"/>

            <TextBlock Grid.Column="1"
                       Text="CommandTrack"
                       Foreground="#566174"/>
        </Grid>
    </Grid>
</Window>