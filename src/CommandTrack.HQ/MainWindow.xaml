<Window x:Class="CommandTrack.HQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommandTrack HQ"
        Width="1200"
        Height="720"
        MinWidth="950"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#10141C">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="DashboardCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#1A2130"/>
            <Setter Property="BorderBrush" Value="#2A3447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2878D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#151B26"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="#2A3447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#151B26"/>
            <Setter Property="AlternatingRowBackground" Value="#192130"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#283246"/>
            <Setter Property="VerticalGridLinesBrush" Value="#283246"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="48"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20293A"/>
            <Setter Property="Foreground" Value="#C9D3E3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#2A3447"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CommandTrack HQ"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Operational unit monitoring dashboard"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#8F9BAD"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <StackPanel Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Last refresh"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#7F8A9B"/>

                    <TextBlock x:Name="LastRefreshTextBlock"
                               Text="Not loaded"
                               HorizontalAlignment="Right"
                               FontSize="13"/>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Content="Refresh"/>
            </StackPanel>
        </Grid>

        <!-- Summary cards -->
        <Grid Grid.Row="1"
              Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL UNITS"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8F9BAD"/>

                    <TextBlock x:Name="TotalUnitsTextBlock"
                               Text="0"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="ONLINE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8F9BAD"/>

                    <TextBlock x:Name="OnlineUnitsTextBlock"
                               Text="0"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#4BD58A"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}"
                    Margin="0">
                <StackPanel>
                    <TextBlock Text="OFFLINE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8F9BAD"/>

                    <TextBlock x:Name="OfflineUnitsTextBlock"
                               Text="0"
                               Margin="0,8,0,0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#F06C75"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Unit table -->
        <Border Grid.Row="2"
                Background="#151B26"
                BorderBrush="#2A3447"
                BorderThickness="1"
                CornerRadius="10"
                Padding="1">

            <DataGrid x:Name="UnitsDataGrid"
                      AlternationCount="2">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Call sign"
                                        Binding="{Binding CallSign}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"
                                        Width="150"/>

                    <DataGridTemplateColumn Header="Status"
                                            Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBadge"
                                        HorizontalAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        Background="#485365">

                                    <TextBlock Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="Online">
                                        <Setter TargetName="StatusBadge"
                                                Property="Background"
                                                Value="#17663F"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="Offline">
                                        <Setter TargetName="StatusBadge"
                                                Property="Background"
                                                Value="#71323A"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Battery"
                                        Binding="{Binding BatteryDisplay}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Speed"
                                        Binding="{Binding SpeedDisplay}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Position"
                                        Binding="{Binding PositionDisplay}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Last seen"
                                        Binding="{Binding LastSeenDisplay}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready"
                       Foreground="#8F9BAD"/>

            <TextBlock Grid.Column="1"
                       Text="CommandTrack"
                       Foreground="#566174"/>
        </Grid>
    </Grid>
</Window>